  "source_version": "1.1.0",
  "classes": {
    "automatico": "Información mínima suficiente para una consulta de lectura; sin ejecutar operaciones.",
    "supervisado": "Información suficiente, pero requiere confirmación y permisos fuera del modelo.",
    "insatisfecho": "Faltan datos mínimos; preguntar específicamente y volver a evaluar en otro turno.",
    "humano": "Se requiere una persona o una capacidad no disponible; punto de integración pendiente.",
    "desconocido": "No se entiende la solicitud o la respuesta; pedir reformulación."
  },
  "questions": {
    "scope": {
      "es": "¿Quieres consultar un producto específico o todos tus productos?",
      "en": "Do you want to view one product or all your products?",
      "pt": "Você quer consultar um produto específico ou todos os seus produtos?"
    },
    "period": {
      "es": "¿Qué periodo quieres consultar?",
      "en": "Which period would you like to view?",
      "pt": "Qual período você quer consultar?"
    },
    "details": {
      "es": "Cuéntanos qué ocurrió y qué necesitas que revisemos.",
      "en": "Tell us what happened and what you need us to review.",
      "pt": "Conte o que aconteceu e o que você precisa que seja analisado."
    },
    "service": {
      "es": "¿Con qué servicio necesitas ayuda?",
      "en": "Which service do you need help with?",
      "pt": "Com qual serviço você precisa de ajuda?"
    },
    "selection": {
      "es": "¿Qué producto, movimiento o solicitud quieres consultar? Indica su referencia.",
      "en": "Which product, transaction or request do you want to view? Provide its reference.",
      "pt": "Qual produto, movimentação ou solicitação deseja consultar? Informe a referência."
    },
    "topic": {
      "es": "¿Sobre qué tema necesitas información?",
      "en": "What topic do you need information about?",
      "pt": "Sobre qual assunto precisa de informações?"
    },
    "objective": {
      "es": "No entendí tu solicitud. ¿Puedes indicar nuevamente qué necesitas consultar o solicitar?",
      "en": "I did not understand your request. Could you explain what you need to view or request?",
      "pt": "Não entendi sua solicitação. Pode explicar novamente o que deseja consultar ou solicitar?"
    }
  },
