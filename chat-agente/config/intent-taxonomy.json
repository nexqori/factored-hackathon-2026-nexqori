    {
      "id": "documents",
      "definition": "Solicitar reporte, estado de cuenta como archivo, documento, exportación o envío de un resumen; capacidad pendiente.",
      "examples": {
        "es": "Necesito un reporte de mis movimientos en PDF.",
        "en": "I need a PDF report of my transactions.",
        "pt": "Preciso de um relatório das minhas movimentações em PDF."
      }
    }
  ]
}
