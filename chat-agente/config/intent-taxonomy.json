    {
      "id": "home",
      "definition": "Volver al inicio.",
      "examples": {
        "es": "Ir al inicio",
        "en": "Go home",
        "pt": "Ir ao início"
      }
    },
    {
      "id": "unknown",
      "definition": "Ambigüedad, negación, sin coincidencia o fuera de alcance.",
      "examples": {
        "es": "Necesito algo",
        "en": "I need something",
        "pt": "Preciso de algo"
      }
    },
    {
      "id": "restricted",
      "definition": "Administración: señal informativa, permisos en servidor.",
      "examples": {
        "es": "Abrir administración",
        "en": "Open administration",
        "pt": "Abrir administração"
      }
