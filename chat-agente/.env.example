# Referencia local del paquete. NO crea variables ni activa el agente automáticamente.
# Las dos claves ya están declaradas en ../.env.example.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# DATABASE_URL ya es consumida por backend/db.py y la inyecta Compose en el backend.
# Para ejecución independiente se debe proporcionar por entorno o en ../.env.
# Formato libpq: postgresql://usuario:password_url_encoded@host:puerto/nexqori
DATABASE_URL=
