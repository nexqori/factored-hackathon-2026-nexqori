# Copiar como chat-agente/.env si se necesitan ajustes locales.
# Settings.from_env lee raíz .env, este .env local y después el entorno del proceso.
# Las dos claves ya están declaradas en ../.env.example.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# DATABASE_URL ya es consumida por backend/db.py y la inyecta Compose en el backend.
# Si está vacía, se construye automáticamente con APP_DATABASE_PASSWORD del .env raíz.
# Formato libpq: postgresql://usuario:password_url_encoded@host:puerto/nexqori
DATABASE_URL=
# Opcional: si no se usa la contraseña ya definida en el .env raíz.
APP_DATABASE_PASSWORD=
# Defaults iguales a Compose. db sólo resuelve dentro de su red Docker.
# Fuera de Docker indicar un host/puerto accesibles de una base preparada.
PGHOST=db
PGPORT=5432
PGUSER=nexqori_app
PGDATABASE=nexqori
