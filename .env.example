# Run npm run setup to generate .env with unique passwords.
CUSTOMER_PASSWORD=
ADMIN_PASSWORD=
SECOND_CUSTOMER_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
APP_DATABASE_PASSWORD=
APP_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
COOKIE_SECURE=false

# AWS HTTPS override: hostname only, e.g. demo.your-domain.com.
PUBLIC_DOMAIN=

# Demo profile: private JSON from the deployment secret, or the mounted private file.
# Default true: API startup requires the profile and creates/synchronizes it.
# Set false only for an installation intentionally running without this test profile.
NEXQORI_DEMO_ENABLED=true
NEXQORI_DEMO_PROFILE_JSON=
