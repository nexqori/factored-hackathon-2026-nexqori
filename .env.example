# Run npm run setup to generate .env with unique passwords.
CUSTOMER_PASSWORD=
ADMIN_PASSWORD=
SECOND_CUSTOMER_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
APP_DATABASE_PASSWORD=
APP_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
COOKIE_SECURE=false

# Chat conectado: agent usa Jev y OpenAI; rules mantiene el baseline local.
CHAT_AGENT_MODE=rules
# Activar explícitamente para enviar contexto y datos propios a los proveedores.
CHAT_AGENT_ALLOW_EXTERNAL_DATA=false
OPENAI_API_KEY=
TYPESAFE_API_KEY=