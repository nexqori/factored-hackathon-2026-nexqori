INTENT_MODE=off
INTENT_PROVIDER=rules
INTENT_FALLBACK=rules
INTENT_EXTERNAL_DATA_ALLOWED=false
INTENT_TIMEOUT_MS=3000
INTENT_MAX_RETRIES=1
INTENT_LOG_RAW_TEXT=false
TYPESAFE_API_KEY=
