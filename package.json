{
  "name": "nexqori",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Nexqori â€” una forma mÃ¡s cercana de vivir tu banca",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ui": "node scripts/nexqori-smoke.mjs",
    "test:experience": "node scripts/nexqori-experience.mjs",
    "test:claims": "node scripts/nexqori-claims.mjs",
    "test:attention": "npm run build && node scripts/nexqori-attention.mjs",
    "test:notifications": "npm run build && node scripts/nexqori-notifications.mjs",
    "test:spending": "npm run build && node scripts/nexqori-spending.mjs",
    "test:spending:prepare": "node scripts/prepare-spending-cases.mjs --confirm-local --pack=equipo-ux",
    "test:services": "node scripts/nexqori-services.mjs",
    "setup": "node scripts/setup-local.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "test:api": "python -m pytest backend/tests -q",
    "test:cards": "node scripts/nexqori-cards.mjs",
    "test:cases": "node scripts/nexqori-cases.mjs",
    "test:cases:prepare": "node scripts/nexqori-cases.mjs --prepare",
    "build:lab": "tsc -p experiments/intent-lab/tsconfig.json --noEmit && vite build --config experiments/intent-lab/vite.config.ts",
    "test:lab:flows": "node experiments/intent-lab/check-flow-ui.mjs",
    "test:lab:editor": "node experiments/intent-lab/check-editor-ui.mjs",
    "test:lab:steps": "node experiments/intent-lab/check-step-ui.mjs",
    "test:lab:master": "node experiments/intent-lab/check-master-ui.mjs",
    "test:lab:bank": "node experiments/intent-lab/check-bank-context-ui.mjs",
    "test:payments": "node scripts/nexqori-payments.mjs",
    "test:payments:pending": "node scripts/nexqori-deferred-payments.mjs",
    "test:chat:flow": "npm run build && node scripts/nexqori-chat-flow.mjs",
    "test:chat:live": "node scripts/nexqori-chat-live.mjs --live",
    "test:banking": "node scripts/nexqori-banking-integrated.mjs",
    "test:documents:context": "npm run build && node scripts/nexqori-document-context.mjs",
    "test:ux:prepare": "node scripts/prepare-ux-users.mjs --confirm-local --pack=equipo-ux",
    "test:pdf": "python scripts/verify-query-pdfs.py",
    "test:voice:ui": "npm run build && node scripts/nexqori-voice-ui.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "i18next": "26.4.2",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
